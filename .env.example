# IMPORTANT ON WINDOWS: save the file as UTF-8 *without* BOM. A BOM (the invisible
# bytes EF BB BF that Notepad and PowerShell's Out-File add) breaks the FIRST
# variable in the file - it silently becomes a different key and the value is
# never picked up. In Notepad use 'Save as -> UTF-8' (not 'UTF-8 with BOM'),
# or create the file from the command line:
#   [System.IO.File]::WriteAllText('.env.local', $c, (New-Object System.Text.UTF8Encoding($false)))
#
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is gitignored - never commit real AdSense ids to git.

# Google AdSense publisher id, e.g. ca-pub-1234567890123456
# AdSense -> Account -> Account information -> Publisher ID
VITE_ADSENSE_CLIENT_ID=

# Ad unit ids. Create them in AdSense -> AdSense -> Ad units, and use the
# "Responsive display ad" format. Each placement on the site gets its own id.
VITE_AD_SLOT_HOME=
VITE_AD_SLOT_AFTER_GAME=
VITE_AD_SLOT_IN_ARTICLE=
VITE_AD_SLOT_FOOTER=

# --- Newsletter -----------------------------------------------------------
# The signup form posts straight to your newsletter provider, so no backend
# is needed. Paste the "form action" URL of the provider's embedded form.
#
# Mailchimp   ->  Audience -> Signup forms -> Embedded form -> copy the
#                action, it looks like:
#                https://XXX.usX.list-manage.com/subscribe/post?u=...&id=...
#                the field name is EMAIL
# Buttondown  ->  the form action of your signup form
# Brevo       ->  the form action of your subscription form
#
# Until this is set, the signup form renders nothing at all.
VITE_NEWSLETTER_ACTION=

# Name of the email field the provider expects (EMAIL for Mailchimp/Brevo,
# email for Buttondown).
VITE_NEWSLETTER_FIELD=EMAIL

# Optional page where a subscriber can unsubscribe without sending an email.
VITE_NEWSLETTER_UNSUBSCRIBE=

# --- The daily email -----------------------------------------------------
# The signup form above only collects the addresses. These are what turn the
# addresses into an email every morning.
#
# The cron in vercel.json calls /api/newsletter once a day. Without the
# settings below that route only shows a preview and nothing is ever sent.
#
# Mailchimp -> Account -> Extras -> API keys -> Create a key
# The key looks like xxxxxxxx-us21 and the part after the dash is the
# datacenter the account lives in - the route reads it out of the key.
MAILCHIMP_API_KEY=

# Mailchimp -> Audience -> Settings -> the "Audience ID" (not the name)
MAILCHIMP_LIST_ID=

# The name the email is sent from. It has to be a sender the account has
# verified, or Mailchimp refuses to send.
MAILCHIMP_FROM_NAME=USA GeoArena

# Where the replies go. It has to be a verified sender as well.
MAILCHIMP_REPLY_TO=contact@geoarena.com

# The secret the cron sends with the request. Vercel adds it as
# "Authorization: Bearer <CRON_SECRET>". Any long random string will do:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the route will not send anything, which is deliberate - a route
# that sends on every visit is a way to burn a sending allowance in an
# afternoon.
CRON_SECRET=

# --- Google Analytics 4 ---------------------------------------------------
# The measurement id of your GA4 property, e.g. G-XXXXXXXXXX.
# Google Analytics -> Admin -> Property settings -> Installation -> Google tag ID
#
# The script is only loaded after the visitor accepts analytics cookies in the
# consent banner. Nothing is reported before that, and the banner also writes
# the "denied" default into the data layer, so Google never learns about a
# visitor who has not agreed to anything.
VITE_GA_MEASUREMENT_ID=

# Set to true to see the events in the GA4 realtime view while developing.
VITE_GA_DEBUG=false

# --- Site sign-in ---------------------------------------------------------
# Supabase Auth is used for Google, Apple and email sign-in. These are public
# browser values (the anon key is designed to be public); never put the service
# role key here.
#
# Supabase -> Authentication -> Providers: enable Google, Apple and Email.
# Add http://localhost:5173/auth/callback and the live /auth/callback URL to
# the redirect allow-list.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- The server -----------------------------------------------------------
# These are read by the server routes in /api, never by the browser. They are
# NOT VITE_ variables on purpose: Vite would put them into the JavaScript that
# everybody downloads, and the keys would be public.
#
# On Vercel set them as Environment Variables in the project settings.
# Locally put them in `.env.local` - `npm run dev` serves the routes from
# /server and hands them these values.

# The address the site is on. The share links and the picture that goes with
# a shared result are built from it.
SITE_URL=https://geo-arena-six.vercel.app

# --- The database ---------------------------------------------------------
# The global leaderboard, the Pro licences and the questions players send in.
# Supabase -> Project -> Settings -> API
# The service role key is the one that can write. Never put it in a VITE_
# variable and never put it in the browser.
#
# Run supabase/schema.sql once to create the tables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pro ------------------------------------------------------------------
# Lemon Squeezy is the merchant of record: it takes the money, handles the
# tax and the refunds, and pays the money on.
#
# Lemon Squeezy -> Settings -> API -> create a key
# Lemon Squeezy -> Store -> Products -> your monthly product -> Variant id
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_VARIANT_ID=

# The secret the webhook is signed with.
# Lemon Squeezy -> Settings -> Webhooks -> your endpoint -> Secret
LEMON_SQUEEZY_WEBHOOK_SECRET=



# Pexels is only used by the local image-fetch script, never in the browser.
# https://www.pexels.com/api/

# Private /admin/newsletter desk. Long random string; server-side only.
ADMIN_SECRET=

PEXELS_API_KEY=
